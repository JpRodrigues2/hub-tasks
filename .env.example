# Bnexo (DAC) — bundle Essencial
BNEXO_MCP_URL=
BNEXO_MCP_TOKEN=

# Funifier PM
FUNIFIER_PM_MCP_URL=https://pm-mcp.funifier.com/mcp
FUNIFIER_PM_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resumo diário
RESUMO_HORARIO=09:00
TZ_HUB=America/Sao_Paulo

# Trava: false = o hub não muda status nem comenta nas ferramentas de gestão
HUB_ESCRITA_PM=false
# Opcional: IDs (vírgula) — com isso, a escrita vale só para essas tasks
HUB_ESCRITA_PM_SOMENTE=

# ── Servidor (v2). No Mac, deixe tudo comentado: os padrões são os da v1. ──
# O hub.service já define estas variáveis (deploy/preparar-vm.sh); aqui só para referência.
# HUB_DADOS_DIR=/home/hub/dados          # banco, cofre cifrado, OAuth, logs, regras, apps.yaml
# HUB_RUNS_DIR=/srv/hub/runs             # prompts e anexos das tasks (o agente lê pelo grupo)
# HUB_REPOS_DIR=/srv/hub/repos           # pasta relativa no apps.yaml resolve aqui
# HUB_CLAUDE_DIR=/home/agente/.claude    # histórico das sessões de quem roda o Claude
# ORCA_BIN=/usr/bin/orca-ide
# ORCA_ENVIRONMENT=agente                # pareamento do hub com o Orca do usuário agente
# HUB_CONFIAR_PASTA_CMD=/usr/local/bin/hub-confiar-pasta
# HUB_COFRE=arquivo-cifrado              # keychain no Mac (padrão), arquivo-cifrado no servidor
